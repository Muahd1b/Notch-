#!/usr/bin/env python3
"""Check only staged, authored text: 5,000 tokens = 20,000 bytes."""

import fnmatch
import os
from pathlib import PurePosixPath
import subprocess
import sys


MAX_BYTES = 20_000
GENERATED_DIRS = {
    "node_modules", "vendor", "dist", "build", "target", "coverage",
    ".next", ".nuxt", ".terraform", ".orchestration", "__generated__",
    "generated", "site-mirror", "site-mirrors", "mirrors", "captures",
}
GENERATED_NAMES = (
    "*.lock", "*.lockb", "*.lock.json", "package-lock.json",
    "npm-shrinkwrap.json", "pnpm-lock.yaml", "bun.lock", "yarn.lock",
    "Cargo.lock", "Gemfile.lock", "Pipfile.lock", "poetry.lock", "uv.lock",
    "go.sum", "*.min.js", "*.min.css", "*.map", "*.snap",
    "*.generated.*", "*.g.cs", "*.g.dart", "*.pb.go", "*_pb2.py",
    "*_pb2_grpc.py", "next-env.d.ts", "payload-types.ts",
)
ASSET_SUFFIXES = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".avif", ".ico", ".svg",
    ".pdf", ".woff", ".woff2", ".ttf", ".otf", ".mp3", ".mp4", ".mov",
    ".wav", ".ogg", ".webm", ".zip", ".gz", ".br", ".tar", ".7z",
    ".wasm", ".bin", ".sqlite", ".db", ".glb", ".gltf", ".blend",
}


def git(*args):
    return subprocess.check_output(["git", "--literal-pathspecs", *args])


def exempt_path(path):
    file = PurePosixPath(path)
    return (
        bool(GENERATED_DIRS.intersection(file.parts[:-1]))
        or file.suffix.lower() in ASSET_SUFFIXES
        or any(fnmatch.fnmatchcase(file.name, pattern) for pattern in GENERATED_NAMES)
    )


def generated_attribute(path):
    fields = git(
        "check-attr", "--cached", "-z", "linguist-generated",
        "linguist-vendored", "filter", "--", path,
    ).split(b"\0")
    return any(
        (fields[i + 1] == b"filter" and fields[i + 2] == b"lfs")
        or (fields[i + 1] != b"filter" and fields[i + 2] in (b"set", b"true"))
        for i in range(0, len(fields) - 1, 3)
    )


def main():
    os.chdir(os.fsdecode(git("rev-parse", "--show-toplevel")).rstrip("\n"))
    paths = git(
        "diff", "--cached", "--name-only", "--no-renames",
        "--diff-filter=ACMRT", "-z", "--",
    ).split(b"\0")
    failures = []
    for raw_path in filter(None, paths):
        path = os.fsdecode(raw_path)
        if exempt_path(path):
            continue
        entry = git("ls-files", "--stage", "-z", "--", path)
        if not entry.startswith((b"100644 ", b"100755 ")):
            continue  # Symlinks and submodule entries are not authored file blobs.
        size = int(git("cat-file", "-s", ":" + path))
        if size <= MAX_BYTES or generated_attribute(path):
            continue
        content = git("show", ":" + path)
        header = content[:2048].lower()
        if b"\0" in content or any(marker in header for marker in (
            b"@generated", b"<auto-generated", b"automatically generated",
            b"code generated", b"do not edit",
        )):
            continue
        failures.append((path, size))
    if not failures:
        return 0
    print("Commit blocked: staged authored files exceed 5,000 tokens (bytes / 4).", file=sys.stderr)
    for path, size in failures:
        print(f"  {path!r}: {size:,} bytes / 4 = {size / 4:,.2f} tokens", file=sys.stderr)
    print(
        "\nSplit each listed file before committing:\n"
        "1. Extract independent responsibilities into smaller modules/components;\n"
        "   move shared types/helpers into focused files and update imports/exports.\n"
        "2. Split long tests by behavior, docs by topic with links, and CSS by component.\n"
        "3. Keep each authored text file <= 20,000 bytes; keep source <= 500 LOC\n"
        "   (tests, docs/Markdown and CSS are exempt from the LOC rule).\n"
        "4. Run the affected check, stage the split files and updated callers with\n"
        "   git add -- <paths>, then retry the commit. This checks the staged version.\n"
        "For real generated/vendor output only, add a narrow path rule to\n"
        ".gitattributes: path/to/output linguist-generated=true, and stage it.\n"
        "Do not mark authored source generated or bypass the hook to avoid splitting.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        print(f"File-size check failed: Git exited {error.returncode}; fix the Git error and retry.", file=sys.stderr)
        sys.exit(1)
